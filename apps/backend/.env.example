# ---- Primary LLM & Evaluator Config ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=your-model-name-here


MYLLM_API_URL=
MYLLM_AUTH_TOKEN=
MYLLM_MODEL_NAME=
MYLLM_TIMEOUT_SECONDS=60
MYLLM_MAX_RETRIES=3
MYLLM_RETRY_DELAY_SECONDS=2.0
MYLLM_HEALTH_CHECK_ATTEMPTS=2
MYLLM_HEALTH_CHECK_TIMEOUT_SECONDS=10
MYLLM_HEALTH_CHECK_COOLDOWN_SECONDS=60

# ---- OpenRouter ----
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL_NAME=liquid/lfm-2.5-2.6b:free
OPENROUTER_SUPPORTS_STRUCTURED_OUTPUT=false

# ---- Groq ----
GROQ_API_KEY=your-groq-key-here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ---- LLM chain order per role ----
# Comma-separated, tried left to right. Valid names: myllm, openrouter, groq.
# AGENT   = the ReAct "what tool to call next" decision step.
# GENERATE = answer generation, claim extraction, section filtering, chunking preamble.
LLM_AGENT_CHAIN=myllm
LLM_GENERATE_CHAIN=myllm

# ---- Vector store ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_harness_chunks

# ---- Agent loop guards ----
HARNESS_MAX_ITERATIONS=8
HARNESS_MAX_TOKEN_BUDGET=12000
HARNESS_MAX_SEARCH_ATTEMPTS=4
HARNESS_MAX_VALIDATION_RETRIES=2
HARNESS_STUCK_LOOP_WINDOW=3

# ---- NLI Verification ----
NLI_ENTAILMENT_THRESHOLD=0.35
NLI_CONTRADICTION_MAX=0.5

# ---- Embedding (LM Studio) ----
EMBEDDING_NOMIC_BACKEND=lmstudio
EMBEDDING_NOMIC_BASE_URL=http://127.0.0.1:1234
EMBEDDING_NOMIC_MODEL=text-embedding-nomic-embed-text-v1.5@q8_0

# ---- Evals Concurrency ----
RAG_QUERY_WORKERS=4
RAGAS_EVAL_WORKERS=4

# ---- Retrieval Thresholds ----
RETRIEVAL_MIN_RELEVANCE_SCORE=-2.0

