# ---- MyLLM (self-hosted primary backend) ----
# MYLLM_MODEL_NAME holds the real underlying model identifier and is never
# printed in logs or exposed via the API — only "myllm" is used anywhere
# user-visible (logs, /v1/health/llm, etc).
MYLLM_API_URL=http://your-myllm-host:8001/v1/chat/completions
MYLLM_AUTH_TOKEN=your-myllm-token-here
MYLLM_MODEL_NAME=your-model-name-here
MYLLM_TIMEOUT_SECONDS=60
MYLLM_MAX_RETRIES=3
MYLLM_RETRY_DELAY_SECONDS=2.0
MYLLM_HEALTH_CHECK_ATTEMPTS=2
MYLLM_HEALTH_CHECK_TIMEOUT_SECONDS=10
MYLLM_HEALTH_CHECK_COOLDOWN_SECONDS=60

# ---- OpenRouter ----
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL_NAME=liquid/lfm-2.5-2.6b:free
OPENROUTER_SUPPORTS_STRUCTURED_OUTPUT=false

# ---- Groq ----
GROQ_API_KEY=your-groq-key-here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# ---- LLM chain order per role ----
# Comma-separated, tried left to right. Valid names: myllm, openrouter, groq.
# AGENT   = the ReAct "what tool to call next" decision step.
# GENERATE = answer generation, claim extraction, section filtering, chunking preamble.
LLM_AGENT_CHAIN=myllm,groq
LLM_GENERATE_CHAIN=myllm,openrouter,groq

# ---- Vector store ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_harness_chunks

# ---- Agent loop guards ----
HARNESS_MAX_ITERATIONS=8
HARNESS_MAX_TOKEN_BUDGET=12000
HARNESS_MAX_SEARCH_ATTEMPTS=4
HARNESS_MAX_VALIDATION_RETRIES=2
HARNESS_STUCK_LOOP_WINDOW=3
