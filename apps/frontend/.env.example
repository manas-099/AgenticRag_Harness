# Base URL of your FastAPI backend.
#
# Leave EMPTY (or unset) during local dev to use the Vite dev-server proxy
# defined in vite.config.ts, which forwards /api/* -> http://localhost:8000/v1/*.
# This avoids CORS entirely while developing.
#
# For a production build, set this to the real, absolute backend URL, e.g.:
#   VITE_API_BASE_URL=https://api.your-domain.com/v1
VITE_API_BASE_URL=
